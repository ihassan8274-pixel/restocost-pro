# ============================================================
# RestoCost Pro - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=3032
HOST=0.0.0.0
NODE_ENV=production

# Database (Railway provides DATABASE_URL automatically)
# For local development, use your local PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/restocost
# On Railway, this is automatically provided

# JWT Secret for sessions (generate a strong random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production

# CORS Origin (your frontend domain)
# For production: https://your-app.railway.app or your custom domain
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# Frontend URL (for links in emails, etc.)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# ============================================================
# Optional: Email (for notifications, password reset, etc.)
# ============================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=RestoCost Pro <noreply@yourdomain.com>

# ============================================================
# Optional: File Storage (for uploads, exports, etc.)
# ============================================================
# STORAGE_TYPE=local  # or s3, gcs
# UPLOAD_DIR=./uploads

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=info