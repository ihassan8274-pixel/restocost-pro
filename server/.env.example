# RestoCost ERP Pro — production configuration
# Copy to server/.env and adjust. Keep server/.env out of version control (gitignored).

# HTTP port the API + built SPA listens on (default 3001).
PORT=3001

# Session lifetime in ms (default 30 days).
SESSION_TTL_MS=2592000000

# Failed logins allowed before temporary lockout (default 5).
LOGIN_MAX_ATTEMPTS=5

# Lockout duration in ms (default 10 minutes).
LOGIN_LOCK_MS=600000