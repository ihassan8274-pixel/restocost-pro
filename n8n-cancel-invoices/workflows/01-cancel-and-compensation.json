        "jsCode": "const target = $('تحليل التعويض').item.json.invoiceNo;\nconst rows = $input.all().map(i => i.json);\nconst found = rows.find(r => String(r['رقم الفاتورة']) === String(target));\nreturn [{ json: { found: !!found, row: found || {}, invoiceNo: target, photoFileId: $('تحليل التعويض').item.json.photoFileId, date: $('تحليل التعويض').item.json.date, chatId: $('تحليل التعويض').item.json.chatId } }];"
