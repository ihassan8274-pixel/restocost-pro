      "id": "switch",
      "name": "نوع الرسالة",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const msg = $input.first().json.message;\nconst caption = msg.caption || msg.text || '';\nconst invoiceMatch = caption.match(/رقم الفاتورة[:\\s]*([\\w-]+)/) || caption.match(/رقم[:\\s]*([\\w-]+)/);\nconst branchMatch = caption.match(/الفرع[:\\s]*(.+)/);\nconst reasonMatch = caption.match(/السبب[:\\s]*(.+)/);\nconst photo = Array.isArray(msg.photo) && msg.photo.length ? msg.photo[msg.photo.length-1].file_id : null;\nreturn [{ json: { ok: !!invoiceMatch, invoiceNo: invoiceMatch ? invoiceMatch[1].trim() : '', branch: branchMatch ? branchMatch[1].trim().split('\\n')[0] : 'غير محدد', reason: reasonMatch ? reasonMatch[1].trim().split('\\n')[0] : 'غير محدد', cashier: msg.from ? ((msg.from.first_name || '') + ' ' + (msg.from.last_name || '')).trim() : 'غير معروف', chatId: msg.chat.id, photoFileId: photo, date: new Date().toISOString() } }];"
      },
      "id": "parse-cancel",
      "name": "تحليل الإلغاء",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.ok }}",
              "value2": true
            }
          ]
        }
      },
