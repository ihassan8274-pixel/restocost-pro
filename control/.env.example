# ═══════════════════════════════════════════════════════
#  Control Plane — أسرار محلية
#  ⛔ هذا الملف مُستثنى من git — تحقق من .gitignore
# ═══════════════════════════════════════════════════════

# ⭐ توكن الكتابة: مطلوب لإضافة/تعديل/حذف شركة
#    ⭐ ضع أي نص عشوائي طويل. مثال التوليد:
#       node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CONTROL_ADMIN_TOKEN=CHANGE_ME_ضع_توكين_عشوائي_طويل

# ⭐ عنوان Postgres لإنشاء قواعد البيانات
#    ⭐ role بـ CREATEDB فقط — ⛔ ليس superuser
#    أنشئه مرة واحدة:
#      CREATE ROLE restocost_admin LOGIN PASSWORD 'xxx' CREATEDB;
#    ⛔ لا تضع هنا كلمة مرور مستخدم البيانات نفسه
PG_ADMIN_URL=postgres://restocost_admin:CHANGE_ME@127.0.0.1:5432/postgres

# قالب عنوان قاعدة بيانات الشركة
DATABASE_URL_TEMPLATE=postgres://restocost:CHANGE_ME@127.0.0.1:5432/PLACEHOLDER

# النطاق العام — يُستخدم لتوليد subdomain مقترح
PUBLIC_DOMAIN=restocost.shop

LOG_LEVEL=info
